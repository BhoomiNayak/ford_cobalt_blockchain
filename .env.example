# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=ford_cobalt

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/ford_cobalt_auth

# ── Blockchain ────────────────────────────────────────────────────────────────
WEB3_PROVIDER_URL=http://localhost:8545
MINE_REGISTRY_ADDRESS=
BATCH_TRACKING_ADDRESS=
COMPLIANCE_VERIFIER_ADDRESS=
# Private key of the deployer/signer wallet (without 0x prefix)
DEPLOYER_PRIVATE_KEY=

# For testnet/mainnet deployment
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGONSCAN_API_KEY=

# ── IPFS ──────────────────────────────────────────────────────────────────────
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=https://ipfs.io/ipfs

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
